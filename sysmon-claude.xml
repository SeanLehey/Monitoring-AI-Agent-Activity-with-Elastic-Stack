<Sysmon schemaversion="4.91">
  <HashAlgorithms>SHA256</HashAlgorithms>
  <EventFiltering>
    <RuleGroup name="Claude process creation" groupRelation="or">
      <ProcessCreate onmatch="include">
        <Image condition="contains">Claude</Image>
        <ParentImage condition="contains">Claude</ParentImage>
        <ParentImage condition="contains">\Git\</ParentImage>
      </ProcessCreate>
    </RuleGroup>
    <RuleGroup name="Electron helper noise" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <CommandLine condition="contains">--type=</CommandLine>
      </ProcessCreate>
    </RuleGroup>
    <RuleGroup name="Claude Code file creation" groupRelation="or">
      <FileCreate onmatch="include">
        <Image condition="contains">\claude-code\</Image>
        <Image condition="contains">\Git\</Image>
      </FileCreate>
    </RuleGroup>
    <RuleGroup name="Claude network connections" groupRelation="or">
      <NetworkConnect onmatch="include">
        <Image condition="contains">Claude</Image>
      </NetworkConnect>
    </RuleGroup>
    <RuleGroup name="Suppress default noise" groupRelation="or">
      <ProcessTerminate onmatch="include"/>
      <FileCreateTime onmatch="include"/>
      <DriverLoad onmatch="include"/>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
